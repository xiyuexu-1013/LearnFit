{
  "manifest_version": 3,
  "name": "LearnFit Task Focus",
  "version": "1.3.1",
  "minimum_chrome_version": "116",
  "description": "On-device focus estimates for user-verified, screen-based study pages.",
  "permissions": [
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://learnfit.pages.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LearnFit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'self';"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  }
}
